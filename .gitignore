# MCP / session logs — machine-local, never commit
logs/

# Python
__pycache__/
*.pyc
.venv/

# Exp 1: model checkpoints are large and regenerable from configs + seeds
experiments/exp1/checkpoints/*
!experiments/exp1/checkpoints/.gitkeep

# Exp 1b: same rule, same reason (188 MB after a single 1M cell). The record
# is the durable artifact; checkpoints regenerate from config + seed.
experiments/exp1b/checkpoints/*
!experiments/exp1b/checkpoints/.gitkeep

# OS
.DS_Store

# Exp1: derived result visualizations (regenerable)
experiments/exp1/results/**/*.html
experiments/exp2/results/activations/
experiments/exp2b/results/activations/
_build.html
experiments/exp2c/results/activations/

# Replay logs; the per-candidate results themselves ARE committed
# (paper/per_candidate.json) because they are the evidence behind two
# published numbers and regenerating them needs 26 GB of activations
# that this repo does not carry.
paper/refit.log

# Exp 2f: eval-item activations (431 MB) follow 2b/2c's policy — digests committed, arrays not
experiments/exp2f/results/activations_eval/
# exp2g stage-1 eval activations (~2.4 GB): digests live in the sealed predictor; arrays not committed (2b/2c/2f policy)
experiments/exp2g/results/activations_eval/
# exp2g sweep/watcher logs — machine-local, never part of the closed record
experiments/exp2g/*.log
# exp2i scan/sweep/watcher logs — machine-local, never part of the closed record
experiments/exp2i/*.log
.superpowers/
# exp2l campaign/stage logs — machine-local, never part of the closed record
# (the committed mutation_*.log files ARE the mutation battery's record, so
# this is a named list rather than experiments/exp2l/*.log; freeze D-1)
experiments/exp2l/preflight.log
experiments/exp2l/endpoint.log
experiments/exp2l/power.log
experiments/exp2l/sweep.log
experiments/exp2l/analyzer.log
experiments/exp2l/watcher_*.log
# exp2m campaign/stage logs — machine-local, never part of the closed record (named list, 2l D-1)
experiments/exp2m/preflight.log
experiments/exp2m/endpoint.log
experiments/exp2m/power.log
experiments/exp2m/sweep.log
experiments/exp2m/analyzer.log
experiments/exp2m/watcher_endpoint.log
experiments/exp2m/watcher_sweep.log
